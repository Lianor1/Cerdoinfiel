---
import Layout from '../../layouts/Layout.astro';
import { historias } from '../../data/historias.js';
---

<Layout title="Cerdo Infiel | La Confesión">
  <main class="salsas-page">
    
    <section class="hero-section">
      <h1 class="hero-title-main">LA CONFESIÓN</h1>
      <p class="hero-subtitle">La historia de un romance prohibido con el sabor.</p>
      <div class="scroll-down">
        <span>DESLIZA PARA DESCUBRIR</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-down">
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </section>

    <!-- Swiper Carousel Section -->
    <section class="carousel-section">
      <swiper-container 
        class="my-swiper"
        effect="coverflow" 
        grab-cursor="true" 
        centered-slides="true" 
        slides-per-view="auto" 
        coverflow-effect-rotate="0" 
        coverflow-effect-stretch="0" 
        coverflow-effect-depth="200" 
        coverflow-effect-modifier="1" 
        coverflow-effect-slide-shadows="true"
        keyboard="true"
        mousewheel="true"
        loop="true"
      >
        {historias.map((historia) => (
          <swiper-slide class="swiper-card" style={`background-image: url('${historia.imagen}');`}>
            {historia.tipo === 'capitulo' ? (
              <article class="chapter">
                <div class="card-content">
                  <h2 class="chapter-number">{historia.numero}</h2>
                  <h3 class="chapter-title">{historia.titulo}</h3>
                  <p class="chapter-text" set:html={historia.texto}></p>
                </div>
              </article>
            ) : (
              <div class="chisme-card">
                <div class="card-content">
                  <div class="chisme-user">
                    <div class="avatar">{historia.usuario.includes('@') ? '😈' : '👤'}</div>
                    <div class="user-info">
                      <span class="user-name">{historia.usuario}</span>
                      <span class="user-time">{historia.tiempo}</span>
                    </div>
                  </div>
                  <p class="chisme-msg" set:html={historia.texto}></p>
                </div>
              </div>
            )}
          </swiper-slide>
        ))}
      </swiper-container>

      <div class="btn-container-center">
        <a href="/nuestromenu" class="btn-pecar">QUIERO PECAR YA</a>
      </div>
    </section>

  </main>
</Layout>

<script>
  import { register } from 'swiper/element/bundle';
  register();
</script>

<style>
  .salsas-page {
    width: 100%;
    min-height: 100vh;
    background: #080404; 
    color: #f5efe6;
    padding-top: 8rem;
    padding-bottom: 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow-x: hidden;
  }

  .hero-section {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .hero-title-main {
    font-family: 'Cinzel', serif;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    color: transparent;
    -webkit-text-stroke: 2px #e8006f;
    text-shadow: 0 0 20px rgba(232,0,111,0.5);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-family: 'Cinzel', serif;
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: #D4AF37;
    letter-spacing: 0.1em;
    max-width: 600px;
    margin: 0 auto 2rem auto;
  }

  .scroll-down {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: rgba(255,255,255,0.5);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    animation: bounce 2s infinite;
  }

  .arrow-down { width: 24px; height: 24px; }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
  }

  /* Carousel Section */
  .carousel-section {
    width: 100%;
    max-width: 1900px;
    padding: 2rem 0;
    position: relative;
    z-index: 5;
  }

  .my-swiper {
    width: 100%;
    padding: 50px 0;
  }

  .swiper-card {
    background-position: center;
    background-size: cover;
    width: 320px;
    height: 480px;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  /* EFECTO BLUR PARA LAS TARJETAS TRASERAS (IGUAL A LA FOTO) */
  swiper-slide:not(.swiper-slide-active) {
    filter: blur(5px);
    opacity: 0.6;
  }

  @media (min-width: 768px) {
    .swiper-card {
      width: 400px;
      height: 500px;
    }
  }

  /* Gradiente para que el texto se lea sobre la foto */
  .chapter, .chisme-card {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(8,4,4,0.8) 60%, rgba(8,4,4,1) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* Alinea el texto abajo como en la foto */
  }

  .card-content {
    padding: 2rem;
    max-height: 60%;
    overflow-y: auto;
  }
  
  .chapter-number {
    font-family: 'Cinzel', serif;
    font-size: 0.9rem;
    color: #e8006f;
    letter-spacing: 0.2em;
    margin-bottom: 0.3rem;
  }

  .chapter-title {
    font-family: 'Cinzel', serif;
    font-size: 1.8rem;
    color: #D4AF37;
    margin-bottom: 1rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }

  .chapter-text {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.9);
  }

  :global(.chapter-text strong) { color: #fff; font-family: 'Cinzel', serif; font-size: 1.05rem; }
  :global(.chapter-text em) { color: #e8006f; font-style: italic; }

  .chisme-user {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.2);
  }

  .avatar {
    width: 36px; height: 36px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    backdrop-filter: blur(5px);
  }

  .user-info { display: flex; flex-direction: column; }
  .user-name { font-weight: 700; color: #fff; font-size: 0.9rem; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
  .user-time { font-size: 0.75rem; color: rgba(255,255,255,0.6); }
  
  .chisme-msg {
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.95);
    font-style: italic;
  }

  /* Scrollbar */
  .card-content::-webkit-scrollbar {
    width: 4px;
  }
  .card-content::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.3);
    border-radius: 4px;
  }

  .btn-container-center {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .btn-pecar {
    display: inline-block;
    padding: 1rem 3rem;
    background: linear-gradient(45deg, #e8006f, #ff0055);
    color: white;
    font-family: 'Cinzel', serif;
    font-size: 1.2rem;
    font-weight: 900;
    text-decoration: none;
    border-radius: 30px;
    letter-spacing: 0.1em;
    box-shadow: 0 0 20px rgba(232,0,111,0.5);
    transition: all 0.3s ease;
  }

  .btn-pecar:hover {
    transform: scale(1.05);
    box-shadow: 0 0 40px rgba(232,0,111,0.8);
  }
</style>
