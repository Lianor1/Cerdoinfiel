---
import Layout from '../layouts/Layout.astro';
import { productos as bowls } from '../data/productos';

const salsas = [
  { name: "Suave", desc: "Como una almohada. Un ligero toque de sabor que acaricia tu paladar.", color: "#e8006f", img: "/images/salsa_crema.png" },
  { name: "Fuerte", desc: "Para desahogar tus penas. El picante que te hace olvidar hasta tu nombre.", color: "#ff4d4d", img: "/images/salsa_verde.png" },
  { name: "Extra Picante", desc: "Para tomarse un aguardiente. Solo para los más valientes y atrevidos.", color: "#ff0000", img: "/images/salsa_roja.png" }
];
---

<Layout title="Cerdo Infiel | Nuestro Menú">
  <main class="menu-page">
    
    <!-- ══════════════════════════════════════════════════
         HERO DEL MENÚ
    ══════════════════════════════════════════════════ -->
    <section class="menu-hero">
      <div class="menu-hero-bg"></div>
      <div class="menu-hero-content">
        <p class="menu-eyebrow">Atrévete a probar</p>
        <h1 class="menu-title">LA CARTA INFIEL</h1>
        <p class="menu-subtitle">Elige tu bowl, baña todo en crema y disfruta sin remordimientos.</p>
      </div>
    </section>

    <section class="bowls-section" id="bowls">
      <div class="menu-container">
        <div class="bowls-grid">
          {bowls.map((bowl, index) => (
            <article class="bowl-card group">
              <a href={`/producto/${bowl.id}`} class="bowl-card-link-wrapper" aria-label={`Ver detalle de ${bowl.nombre}`}>
                <div class="bowl-card-image-wrap">
                  <div class="bowl-glow" aria-hidden="true"></div>
                  <img src={bowl.img} alt={`Foto de ${bowl.nombre}`} class="bowl-img" loading="lazy" decoding="async"/>
                </div>
                <div class="bowl-card-content">
                  <div class="bowl-header">
                    <span class="bowl-tag">{bowl.tag}</span>
                    <span class="bowl-price">{bowl.precio}</span>
                  </div>
                  <h2 class="bowl-name">{bowl.nombre}</h2>
                  <p class="bowl-desc">{bowl.descripcion}</p>
                </div>
              </a>
              <div class="bowl-buttons">
                <button class="bowl-btn btn-black">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-right: 4px;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                  AÑADIR AL CARRITO
                </button>
                <button class="bowl-btn btn-green">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51h-.57c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  PEDIR POR WHATSAPP
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════
         SECCIÓN DE SALSAS
    ══════════════════════════════════════════════════ -->
    <section class="salsas-section" id="salsas">
      <div class="menu-container">
        <div class="salsas-header text-center">
          <h2 class="salsas-title">ELIGE TU VENENO</h2>
          <p class="salsas-subtitle">Nuestras salsas artesanales coronan tu bowl. ¿Qué tan atrevido eres hoy?</p>
        </div>

        <div class="salsas-grid">
          {salsas.map((salsa) => (
            <div class="salsa-card" style={`--salsa-color: ${salsa.color}`}>
              <div class="salsa-visuals">
                <div class="flame-container">
                  <div class="flame flame-1"></div>
                  <div class="flame flame-2"></div>
                  <div class="flame flame-3"></div>
                </div>
                <div class="salsa-img-wrap">
                  <img src={salsa.img} alt={`Salsa ${salsa.name}`} class="salsa-img" loading="lazy" decoding="async" />
                </div>
              </div>
              <h3 class="salsa-name">{salsa.name}</h3>
              <p class="salsa-desc">{salsa.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ══════════════════════════════════════
     VARIABLES Y SETUP
  ══════════════════════════════════════ */
  .menu-page {
    width: 100%;
    min-height: 100vh;
    background: #080404; /* Color midnight del tema */
    color: #f5efe6;
    overflow-x: hidden;
  }

  .menu-container {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ══════════════════════════════════════
     HERO DEL MENÚ
  ══════════════════════════════════════ */
  .menu-hero {
    position: relative;
    width: 100%;
    padding: 5rem 1.5rem 4rem; /* Reducido de 10rem a 5rem para subir el texto */
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-bottom: 1px solid rgba(232,0,111,0.2);
    overflow: hidden;
  }

  .menu-hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, rgba(232,0,111,0.15) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .menu-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .menu-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: clamp(0.7rem, 2vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.3em;
    color: #e8006f;
    text-transform: uppercase;
    margin: 0;
  }

  .menu-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #fff;
    margin: 0;
    line-height: 1.1;
    text-shadow: 0 0 30px rgba(232,0,111,0.4);
  }

  .menu-subtitle {
    font-family: 'Cinzel', serif;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    font-weight: 400;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.7);
    max-width: 600px;
    margin: 0;
    line-height: 1.6;
    text-wrap: balance;
  }

  /* ══════════════════════════════════════
     SECCIÓN DE BOWLS
  ══════════════════════════════════════ */
  .bowls-section {
    padding: 6rem 0;
    position: relative;
  }

  .bowls-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .bowls-grid {
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .bowls-grid {
      gap: 1.5rem;
    }
  }

  .bowl-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 12px;
    padding: 1.8rem 1.2rem;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .bowl-card {
      width: calc(50% - 1rem);
    }
  }

  @media (min-width: 1024px) {
    .bowl-card {
      width: calc(25% - 1.125rem);
    }
  }

  .bowl-card:hover {
    background: rgba(232,0,111,0.03);
    border-color: rgba(232,0,111,0.3);
    transform: translateY(-10px);
  }

  .bowl-card-image-wrap {
    position: relative;
    width: 180px;
    height: 180px;
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bowl-glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at center, rgba(232,0,111,0.3) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.5s ease;
    border-radius: 50%;
    z-index: 0;
  }

  .bowl-card:hover .bowl-glow {
    opacity: 1;
  }

  .bowl-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 1;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));
  }

  .bowl-card:hover .bowl-img {
    transform: scale(1.15) rotate(2deg);
  }

  .bowl-card-link-wrapper {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    flex-grow: 1;
  }

  .bowl-card-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    position: relative;
    z-index: 1;
    flex-grow: 1;
  }

  .bowl-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 0.5rem;
  }

  .bowl-tag {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #e8006f;
  }

  .bowl-price {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem;
    font-weight: 900;
    color: #fff;
  }

  .bowl-name {
    font-family: 'Cinzel', serif;
    font-size: 1.6rem;
    font-weight: 900;
    color: #fff;
    margin: 0 0 0.5rem 0;
    letter-spacing: 0.05em;
    text-align: center;
  }

  .bowl-desc {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    text-align: center;
  }

  .bowl-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    margin-top: 1rem;
  }

  .bowl-btn {
    width: 100%;
    padding: 0.6rem 0.5rem;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: none;
  }

  .btn-black {
    background: #111;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .btn-black:hover {
    background: #000;
    border-color: #e8006f;
  }

  .btn-green {
    background: #25D366;
    color: #fff;
  }

  .btn-green:hover {
    background: #128C7E;
  }

  /* ══════════════════════════════════════
     SECCIÓN DE SALSAS
  ══════════════════════════════════════ */
  .salsas-section {
    padding: 6rem 0 8rem;
    background: linear-gradient(to bottom, transparent, rgba(232,0,111,0.03));
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .salsas-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 4rem;
    text-align: center;
  }

  .salsas-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: #fff;
    letter-spacing: 0.1em;
    margin: 0 0 1rem 0;
  }

  .salsas-subtitle {
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
    max-width: 500px;
    margin: 0;
    line-height: 1.6;
  }

  .salsas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .salsas-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .salsa-card {
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.05);
    padding: 2.5rem 2rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .salsa-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: var(--salsa-color);
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .salsa-card:hover {
    background: rgba(255,255,255,0.03);
    border-color: rgba(255,255,255,0.1);
    transform: translateY(-5px);
  }

  .salsa-card:hover::before {
    opacity: 1;
    box-shadow: 0 0 15px var(--salsa-color);
  }

  .salsa-visuals {
    position: relative;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .salsa-img-wrap {
    width: 120px;
    height: 120px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(0,0,0,0.5);
    border: 2px solid var(--salsa-color);
    transition: all 0.4s ease;
    box-shadow: 0 0 10px rgba(0,0,0,0.5);
    position: relative;
    z-index: 2;
  }

  .salsa-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  /* Efecto de Fuego (Llamas) */
  .flame-container {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 140px;
    height: 140px;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .flame {
    position: absolute;
    bottom: 10px;
    background: var(--salsa-color);
    border-radius: 50% 0 50% 50%;
    transform: rotate(-45deg);
    filter: drop-shadow(0 0 10px var(--salsa-color)) blur(2px);
  }

  .flame-1 {
    width: 40px; height: 40px;
    left: 15%;
    bottom: 30px;
    animation: flicker 0.6s infinite alternate;
  }
  .flame-2 {
    width: 60px; height: 60px;
    left: 50%; margin-left: -30px;
    animation: flicker 0.5s infinite alternate-reverse;
  }
  .flame-3 {
    width: 45px; height: 45px;
    right: 15%;
    bottom: 25px;
    animation: flicker 0.7s infinite alternate;
  }

  @keyframes flicker {
    0% { transform: rotate(-45deg) scale(0.9) translateY(0); opacity: 0.8; }
    100% { transform: rotate(-45deg) scale(1.1) translateY(-10px); opacity: 1; }
  }

  .salsa-card:hover .salsa-img-wrap {
    transform: translateY(-5px);
    box-shadow: 0 5px 20px var(--salsa-color);
  }
  
  .salsa-card:hover .salsa-img {
    transform: scale(1.1);
  }

  .salsa-card:hover .flame-container {
    opacity: 1;
  }

  .salsa-name {
    font-family: 'Cinzel', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem 0;
    letter-spacing: 0.05em;
  }

  .salsa-desc {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin: 0;
  }
</style>
