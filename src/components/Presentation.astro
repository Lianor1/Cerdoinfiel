---
// Presentation.astro — Cerdo Infiel (selector estilo La Velada VI)
import { productos } from '../data/productos';
---

<section class="pres-section" id="presentacion" aria-label="Presentación de Cerdo Infiel">

  <!-- Fondo glow rosa -->
  <div class="pres-bg-glow" aria-hidden="true"></div>

  <!-- ══════════════════════════════════════
       STAGE PRINCIPAL (efecto Velada VI)
  ══════════════════════════════════════ -->
  <div class="product-stage" id="product-stage">

    <!-- ── PANEL DEFAULT (logo + info) ── -->
    <div class="product-default-panel" id="default-panel" aria-hidden="false">
      <!-- Logo flotante -->
      <div class="default-logo-wrap">
        <img
          src="/images/og.png"
          alt="Cerdo Infiel"
          class="default-logo"
          width="280"
          height="280"
          fetchpriority="high"
        />
      </div>

      <!-- Info -->
      <div class="default-info">
        <p class="default-tagline">"Amor a primera mordida"</p>
        <div class="pres-divider"></div>
        <p class="default-data">
          <span>🕐 MIERCOLES A SABADO</span>
          <span class="pres-sep">·</span>
          <span>10:00 – 16:00</span>
          <span class="pres-sep">·</span>
          <span>ANDAHUAYLAS</span>
        </p>
      </div>
    </div>

    <!-- ── PANEL ACTIVO (producto seleccionado) ── -->
    <div class="product-active-panel" id="active-panel" aria-hidden="true">

      <!-- Marca de agua deslizante (nombre del producto) -->
      <div class="product-watermark" id="product-watermark" aria-hidden="true">
        <div class="watermark-track">
          <div class="watermark-set">
            <span class="watermark-text" id="wm-1">BOWL CLÁSICO</span>
            <span class="watermark-text" id="wm-2">BOWL CLÁSICO</span>
            <span class="watermark-text" id="wm-3">BOWL CLÁSICO</span>
          </div>
          <div class="watermark-set">
            <span class="watermark-text" id="wm-4">BOWL CLÁSICO</span>
            <span class="watermark-text" id="wm-5">BOWL CLÁSICO</span>
            <span class="watermark-text" id="wm-6">BOWL CLÁSICO</span>
          </div>
        </div>
      </div>

      <!-- Imagen héroe grande -->
      <div class="product-hero-layer">
        <img
          src={productos[0].img}
          alt={productos[0].nombre}
          class="product-hero-img"
          id="product-hero-img"
          width="400"
          height="500"
        />
      </div>

      <!-- Glow de color detrás del héroe -->
      <span class="product-glow" id="product-glow" aria-hidden="true"></span>

      <!-- Nombre + descripción -->
      <div class="product-caption">
        <h2 class="product-name" id="product-name">{productos[0].nombre}</h2>
        <p class="product-desc" id="product-desc">{productos[0].descripcion}</p>
      </div>

    </div>

  </div>

  <!-- ══════════════════════════════════════
       FOOTER DEL SELECTOR
  ══════════════════════════════════════ -->
  <div class="selector-foot">

    <!-- Divider decorativo -->
    <div class="selector-cta-bar">
      <div class="divider-line" aria-hidden="true">
        <span class="divider-h"></span>
        <svg viewBox="0 0 24 24" fill="none" class="divider-icon" aria-hidden="true">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"
            fill="currentColor"/>
        </svg>
        <span class="divider-h"></span>
      </div>
      <p class="selector-cta-text" id="selector-cta">¡SELECCIONA TU BOWL FAVORITO!</p>
    </div>

    <!-- Grid de miniaturas -->
    <div class="product-grid" id="product-grid" aria-label="Lista de productos">

      <!-- Marco flotante del selector -->
      <span class="grid-frame" id="grid-frame" aria-hidden="true">
        <span class="gf-corner gf-tl"></span>
        <span class="gf-corner gf-tr"></span>
        <span class="gf-corner gf-bl"></span>
        <span class="gf-corner gf-br"></span>
      </span>

      {productos.map((p, i) => (
        <button
          class="product-cell"
          data-id={p.id}
          data-img={p.img}
          data-nombre={p.nombre}
          data-desc={p.descripcion}
          data-active={i === 0 ? "true" : "false"}
          aria-label={`Ver ${p.nombre}`}
          id={`cell-${p.id}`}
          tabindex={i === 0 ? "0" : "-1"}
        >
          <span class="cell-media">
            <img
              src={p.img}
              alt=""
              role="presentation"
              loading="lazy"
              decoding="async"
              width="160"
              height="160"
              class="cell-img"
            />
            <span class="cell-name-bar" aria-hidden="true">
              <span class="cell-name">{p.nombre}</span>
            </span>
          </span>
          <!-- Marco decorativo de esquinas -->
          <span class="cell-frame" aria-hidden="true">
            <span class="cf-corner cf-tl"></span>
            <span class="cf-corner cf-tr"></span>
            <span class="cf-corner cf-bl"></span>
            <span class="cf-corner cf-br"></span>
          </span>
        </button>
      ))}
    </div>

  </div>

</section>

<!-- ══════════════════════════════════════════════════
     ARSENAL INFIEL — INSUMOS (Estilo Patrocinadores)
══════════════════════════════════════════════════ -->
<section class="arsenal-section" id="arsenal" aria-labelledby="arsenal-title">

  <div class="arsenal-header">
    <p class="arsenal-eyebrow">Nuestros Aliados</p>
    <h2 class="arsenal-title" id="arsenal-title">EL ARSENAL INFIEL</h2>
    <p class="arsenal-subtitle">
      La magia detrás de cada bowl no es casualidad.<br/>
      Seleccionamos lo mejor para que rompas la dieta con orgullo.
    </p>
  </div>

  <!-- ── Banners Superiores ── -->
  <div class="arsenal-banners">
    <div class="ar-banner group">
      <img src="/images/sponsor_banner_1.jpg" alt="Chicharrón crujiente" loading="lazy" decoding="async" class="ar-banner-img"/>
      <div class="ar-banner-overlay"></div>
      <div class="ar-banner-content">
        <p class="ar-banner-tag">El Rey de la Casa</p>
        <p class="ar-banner-title">CHICHARRÓN<br/>CRUJIENTE</p>
        <p class="ar-banner-desc">100% Cerdo seleccionado</p>
      </div>
    </div>
    <div class="ar-banner group">
      <img src="/images/sponsor_banner_2.jpg" alt="Salsas artesanales" loading="lazy" decoding="async" class="ar-banner-img"/>
      <div class="ar-banner-overlay"></div>
      <div class="ar-banner-content">
        <p class="ar-banner-tag">El Toque Final</p>
        <p class="ar-banner-title">SALSAS<br/>ARTESANALES</p>
        <p class="ar-banner-desc">
          <strong>Suave:</strong> Como una almohada<br/>
          <strong>Fuerte:</strong> Para desahogar tus penas<br/>
          <strong>Extra Picante:</strong> Para tomarse un aguardiente
        </p>
      </div>
    </div>
  </div>

  <!-- ── Grilla de Insumos ── -->
  <div class="arsenal-grid" role="list">
    
    <!-- Insumo 1 -->
    <div class="ar-item" tabindex="0" role="listitem">
      <div class="ar-item-frame" aria-hidden="true">
        <span class="ar-corner ar-tl"></span>
        <span class="ar-corner ar-tr"></span>
        <span class="ar-corner ar-bl"></span>
        <span class="ar-corner ar-br"></span>
      </div>
      <img src="/images/sponsor_rocoto.jpg" alt="Rocoto" class="ar-item-img"/>
      <span class="ar-item-label">Rocoto Picante</span>
    </div>

    <!-- Insumo 2 -->
    <div class="ar-item" tabindex="0" role="listitem">
      <div class="ar-item-frame" aria-hidden="true">
        <span class="ar-corner ar-tl"></span>
        <span class="ar-corner ar-tr"></span>
        <span class="ar-corner ar-bl"></span>
        <span class="ar-corner ar-br"></span>
      </div>
      <img src="/images/sponsor_ajo.jpg" alt="Ajo" class="ar-item-img"/>
      <span class="ar-item-label">Ajo</span>
    </div>

    <!-- Insumo 3 -->
    <div class="ar-item" tabindex="0" role="listitem">
      <div class="ar-item-frame" aria-hidden="true">
        <span class="ar-corner ar-tl"></span>
        <span class="ar-corner ar-tr"></span>
        <span class="ar-corner ar-bl"></span>
        <span class="ar-corner ar-br"></span>
      </div>
      <img src="/images/sponsor_huacatay.jpg" alt="Huacatay" class="ar-item-img"/>
      <span class="ar-item-label">Huacatay</span>
    </div>

    <!-- Insumo 4 -->
    <div class="ar-item" tabindex="0" role="listitem">
      <div class="ar-item-frame" aria-hidden="true">
        <span class="ar-corner ar-tl"></span>
        <span class="ar-corner ar-tr"></span>
        <span class="ar-corner ar-bl"></span>
        <span class="ar-corner ar-br"></span>
      </div>
      <img src="/images/sponsor_sal_maras.jpg" alt="Sal de Maras" class="ar-item-img"/>
      <span class="ar-item-label">Sal de Maras</span>
    </div>

    <!-- Insumo 5 -->
    <div class="ar-item" tabindex="0" role="listitem">
      <div class="ar-item-frame" aria-hidden="true">
        <span class="ar-corner ar-tl"></span>
        <span class="ar-corner ar-tr"></span>
        <span class="ar-corner ar-bl"></span>
        <span class="ar-corner ar-br"></span>
      </div>
      <img src="/images/sponsor_aceite.jpg" alt="Aceite de Oliva" class="ar-item-img"/>
      <span class="ar-item-label">Aceite de Oliva</span>
    </div>

    <!-- Insumo 6 -->
    <div class="ar-item" tabindex="0" role="listitem">
      <div class="ar-item-frame" aria-hidden="true">
        <span class="ar-corner ar-tl"></span>
        <span class="ar-corner ar-tr"></span>
        <span class="ar-corner ar-bl"></span>
        <span class="ar-corner ar-br"></span>
      </div>
      <img src="/images/sponsor_galleta.jpg" alt="Galleta" class="ar-item-img"/>
      <span class="ar-item-label">Galleta</span>
    </div>

  </div>

</section>

<script>
  // ──────────────────────────────────────
  // SELECTOR INTERACTIVO (efecto hover puro)
  // Solo muestra el producto mientras el
  // mouse está encima. Al salir → default.
  // ──────────────────────────────────────
  const defaultPanel = document.getElementById('default-panel')!;
  const activePanel  = document.getElementById('active-panel')!;
  const heroImg      = document.getElementById('product-hero-img') as HTMLImageElement;
  const heroName     = document.getElementById('product-name')!;
  const heroDesc     = document.getElementById('product-desc')!;
  const gridFrame    = document.getElementById('grid-frame')!;
  const ctaText      = document.getElementById('selector-cta')!;
  const cells        = document.querySelectorAll<HTMLButtonElement>('.product-cell');
  const wmSpans      = document.querySelectorAll<HTMLElement>('.watermark-text');

  // ── Mostrar producto al hacer hover ──
  function showProduct(btn: HTMLButtonElement) {
    const img    = btn.dataset.img    ?? '';
    const nombre = btn.dataset.nombre ?? '';
    const desc   = btn.dataset.desc   ?? '';

    // Cambiar al panel activo
    defaultPanel.classList.add('is-hidden');
    activePanel.classList.add('is-visible');

    // Imagen con micro-fade
    heroImg.style.opacity = '0';
    requestAnimationFrame(() => {
      heroImg.src = img;
      heroImg.alt = nombre;
      heroImg.style.opacity = '1';
    });

    // Textos
    heroName.textContent = nombre;
    heroDesc.textContent = desc;

    // Marca de agua
    wmSpans.forEach(s => { s.textContent = nombre; });

    // Marco flotante
    const rect     = btn.getBoundingClientRect();
    const gridRect = document.getElementById('product-grid')!.getBoundingClientRect();
    gridFrame.style.width     = `${rect.width + 4}px`;
    gridFrame.style.height    = `${rect.height + 4}px`;
    gridFrame.style.transform = `translate(${rect.left - gridRect.left - 2}px, ${rect.top - gridRect.top - 2}px)`;
    gridFrame.style.opacity   = '1';

    // Estado visual de celdas
    cells.forEach(c => c.setAttribute('data-active', 'false'));
    btn.setAttribute('data-active', 'true');

    // CTA
    ctaText.textContent = `— ${nombre} —`;
  }

  // ── Volver al estado default ──
  function showDefault() {
    defaultPanel.classList.remove('is-hidden');
    activePanel.classList.remove('is-visible');

    cells.forEach(c => c.setAttribute('data-active', 'false'));
    gridFrame.style.opacity = '0';
    ctaText.textContent = '¡SELECCIONA TU BOWL FAVORITO!';
  }

  // ── Eventos de cada celda ──
  cells.forEach(btn => {
    // Hover: mostrar producto
    btn.addEventListener('mouseenter', () => showProduct(btn));

    // Click: ir a sección de detalles del producto
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      window.location.href = `/producto/${id}`;
    });
  });

  // ── Al salir del grid: SIEMPRE volver al default ──
  const grid = document.getElementById('product-grid')!;
  grid.addEventListener('mouseleave', () => showDefault());
</script>

<style>
  /* ══════════════════════════════════════
     VARIABLES
  ══════════════════════════════════════ */
  :root {
    --pink:       #e8006f;
    --pink-glow:  rgba(232, 0, 111, 0.45);
    --cream:      #f5efe6;
    --midnight:   #080404;
  }

  /* ══════════════════════════════════════
     SECCIÓN
  ══════════════════════════════════════ */
  .pres-section {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    padding: 0;
    background: var(--midnight);
    position: relative;
    overflow: hidden;
  }

  /* Glow de fondo */
  .pres-bg-glow {
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse, rgba(232,0,111,0.12) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  /* ══════════════════════════════════════
     STAGE
  ══════════════════════════════════════ */
  .product-stage {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    z-index: 1;
  }

  /* ── PANEL DEFAULT ── */
  .product-default-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 4rem 1.5rem 2rem;
    transition: opacity 0.35s ease, transform 0.35s ease;
    z-index: 2;
  }

  .product-default-panel.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.96);
  }

  .default-logo-wrap {
    animation: float 4s ease-in-out infinite;
  }

  .default-logo {
    width: clamp(160px, 25vw, 280px);
    height: clamp(160px, 25vw, 280px);
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid rgba(232,0,111,0.35);
    box-shadow:
      0 0 40px rgba(232,0,111,0.45),
      0 0 80px rgba(232,0,111,0.18);
    transition: box-shadow 0.4s ease;
  }

  .default-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .default-tagline {
    font-family: 'Cinzel', serif;
    font-size: clamp(0.9rem, 2.5vw, 1.3rem);
    font-weight: 400;
    color: rgba(255,255,255,0.8);
    letter-spacing: 0.18em;
    margin: 0;
    font-style: italic;
  }

  .pres-divider {
    width: 120px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--pink), transparent);
  }

  .default-data {
    font-family: 'Cinzel', serif;
    font-size: clamp(0.55rem, 1.2vw, 0.72rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    color: rgba(255,255,255,0.4);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pres-sep { color: rgba(232,0,111,0.7); }

  /* ── PANEL ACTIVO ── */
  .product-active-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 1rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    z-index: 2;
  }

  .product-active-panel.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Glow de producto */
  .product-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 80%, rgba(232,0,111,0.35) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  /* Marca de agua deslizante */
  .product-watermark {
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .watermark-track {
    display: flex;
    animation: watermark-slide 10s linear infinite;
    width: max-content;
  }

  .watermark-set {
    display: flex;
    gap: 0;
  }

  .watermark-text {
    font-family: 'Cinzel', serif;
    font-size: clamp(5rem, 16vw, 12rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: rgba(255,255,255,0.035);
    white-space: nowrap;
    padding-right: 1.5rem;
  }

  @keyframes watermark-slide {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Imagen héroe */
  .product-hero-layer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    flex: 1;
    padding-top: 4rem;
  }

  .product-hero-img {
    width: clamp(200px, 35vw, 380px);
    height: auto;
    max-height: 55vh;
    object-fit: contain;
    filter: drop-shadow(0 0 40px rgba(232,0,111,0.45));
    transition: opacity 0.25s ease;
    animation: float 5s ease-in-out infinite;
  }

  /* Nombre y descripción */
  .product-caption {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0.75rem 1rem 0;
    margin-top: -0.5rem;
  }

  .product-name {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.5rem, 5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    color: var(--cream);
    margin: 0 0 0.25rem;
    text-shadow: 0 0 30px rgba(232,0,111,0.5);
    line-height: 1;
  }

  .product-desc {
    font-family: 'Cinzel', serif;
    font-size: clamp(0.6rem, 1.4vw, 0.8rem);
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.5);
    margin: 0;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  /* ══════════════════════════════════════
     FOOTER DEL SELECTOR
  ══════════════════════════════════════ */
  .selector-foot {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1rem 3rem;
    z-index: 2;
    position: relative;
  }

  /* CTA decorativo */
  .selector-cta-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .divider-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .divider-h {
    display: block;
    width: clamp(3rem, 8vw, 6rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(232,0,111,0.45));
  }

  .divider-h:last-child {
    background: linear-gradient(270deg, transparent, rgba(232,0,111,0.45));
  }

  .divider-icon {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--pink);
    flex-shrink: 0;
  }

  .selector-cta-text {
    font-family: 'Cinzel', serif;
    font-size: clamp(0.6rem, 1.5vw, 0.78rem);
    font-weight: 900;
    letter-spacing: 0.2em;
    color: rgba(245,239,230,0.7);
    text-transform: uppercase;
    margin: 0;
    transition: all 0.3s ease;
  }

  /* ══════════════════════════════════════
     GRID DE PRODUCTOS
  ══════════════════════════════════════ */
  .product-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
    max-width: 520px;
  }

  /* Marco flotante del selector */
  .grid-frame {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 10;
    opacity: 0;
    transition: width 0.25s ease, height 0.25s ease, transform 0.25s ease, opacity 0.25s ease;
  }

  .gf-corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--pink);
    border-style: solid;
  }
  .gf-corner.gf-tl { top: 0; left: 0;  border-width: 2px 0 0 2px; }
  .gf-corner.gf-tr { top: 0; right: 0; border-width: 2px 2px 0 0; }
  .gf-corner.gf-bl { bottom: 0; left: 0;  border-width: 0 0 2px 2px; }
  .gf-corner.gf-br { bottom: 0; right: 0; border-width: 0 2px 2px 0; }

  /* Celda de producto */
  .product-cell {
    position: relative;
    aspect-ratio: 1;
    cursor: pointer;
    overflow: hidden;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(232,0,111,0.2);
    outline: none;
    transition: background 0.25s ease;
    padding: 0;
  }

  .product-cell:hover,
  .product-cell[data-active="true"] {
    background: rgba(232,0,111,0.08);
  }

  .cell-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: block;
  }

  .cell-img {
    position: absolute;
    inset: 0;
