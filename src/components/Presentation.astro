<script>
  // ── Lightbox comunidad ──
  const cards    = document.querySelectorAll<HTMLButtonElement>('.comm-card');
  const lightbox = document.getElementById('comm-lightbox')!;
  const lbImg    = document.getElementById('lb-img') as HTMLImageElement;
  const lbClose  = document.getElementById('lb-close')!;
  const lbBack   = document.getElementById('lb-backdrop')!;

  function openLightbox(btn: HTMLButtonElement) {
    const img = btn.querySelector<HTMLImageElement>('.comm-img');
    if (!img) return;
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    lightbox.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => lightbox.classList.add('is-open'));
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    setTimeout(() => {
      lightbox.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }, 300);
  }

  cards.forEach(btn => btn.addEventListener('click', () => openLightbox(btn)));
  lbClose.addEventListener('click', closeLightbox);
  lbBack.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>

